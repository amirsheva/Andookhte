<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    api.nuget.org از ایران در دسترس نیست و dotnet restore با خطای NU1301 و
    تایم‌اوت چنددقیقه‌ای شکست می‌خورد. این فایل، مخزن را به یک آینهٔ داخلی
    تغییر می‌دهد.

    <clear /> منبع پیش‌فرض nuget.org را حذف می‌کند؛ بدون آن، NuGet همچنان
    تلاش می‌کند به آن وصل شود و هر restore دقایق طولانی معطل می‌ماند.

    اگر آینهٔ فعلی از کار افتاد، یکی از گزینه‌های پایین را جایگزین کنید.
    هم‌زمان فعال نگه‌داشتن چند آینه توصیه نمی‌شود: NuGet همهٔ منابع را
    پرس‌وجو می‌کند و یک منبع کند، کل restore را کند می‌کند.
  -->

  <packageSources>
    <clear />
    <add key="liara" value="https://package-mirror.liara.ir/repository/nuget/index.json" />

    <!-- گزینه‌های جایگزین:
    <add key="iranserver" value="https://nuget.iranserver.com/repository/nuget/index.json" />
    <add key="nugetiran"  value="https://repo.nugetiran.ir/repository/nuget/index.json" />
    <add key="nuget.org"  value="https://api.nuget.org/v3/index.json" />
    -->
  </packageSources>

</configuration>
