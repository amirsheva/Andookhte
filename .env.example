# این فایل را روی سرور به نام .env کپی کنید و مقادیر را عوض کنید.
# فایل .env هرگز نباید در گیت برود — در .gitignore هست.

POSTGRES_DB=andookhte
POSTGRES_USER=andookhte
POSTGRES_PASSWORD=یک-رمز-قوی-اینجا

# حداقل ۳۲ نویسه. تولید با: openssl rand -base64 48
# برنامه با کلید کوتاه‌تر عمداً بالا نمی‌آید.
JWT_SIGNING_KEY=

# دامنه یا آدرس فرانت‌اند — برای CORS. بدون اسلش انتهایی.
PUBLIC_WEB_URL=http://95.38.188.15

# پنل پیامک؛ تا وقتی خالی باشد کد فقط در لاگ نوشته می‌شود
